#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        arrow: arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp MINUS &kp GT &kp SPACE>;
            label = "ARROW";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
&kp GRAVE  &kp N1                                &kp N2            &kp N3        &kp N4            &kp N5  &none                                                                                    &none              &kp N6  &kp N7             &kp N8     &kp N9    &kp N0    &kp BACKSPACE
&kp TAB    &kp Q                                 &kp W             &kp E         &kp R             &kp T   &kp MINUS                                                                                &kp EQUAL          &kp Y   &kp U              &kp I      &kp O     &kp P     &kp BSLH
&kp CAPS   &kp A                                 &kp S             &kp D         &kp F             &kp G   &kp LEFT_BRACKET  &to 1          &kp LS(LG(N4))      &kp C_VOLUME_UP  &kp ESCAPE         &kp RIGHT_BRACKET  &kp H   &kp J              &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z                                 &kp X             &kp C         &kp V             &kp B                                    &kp LS(LG(N3))      &kp C_VOL_DN                                           &kp N   &kp M              &kp COMMA  &kp DOT   &kp UP    &kp ENTER
&kp ENTER  &kp C_AC_NEXT_KEYBOARD_LAYOUT_SELECT  &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_COMMAND          &kp LEFT_SHIFT    &kp BACKSPACE  &arrow              &bl BL_TOG       &kp C_AL_CALENDAR  &kp SPACE                  &kp RIGHT_COMMAND  &kp SLASH  &kp LEFT  &kp DOWN  &kp RIGHT
            >;
        };

        Number {
            bindings = <
&none  &none  &none  &none  &none  &none  &none                                  &none  &none  &none   &none   &none   &kp PLUS         &kp BACKSPACE
&none  &none  &none  &none  &none  &none  &none                                  &none  &none  &kp N7  &kp N8  &kp N9  &kp KP_MINUS     &none
&none  &none  &none  &none  &none  &none  &none  &to 0  &none      &none  &none  &none  &none  &kp N4  &kp N5  &kp N6  &kp KP_MULTIPLY  &none
&none  &none  &none  &none  &none  &none                &none      &none                &none  &kp N1  &kp N2  &kp N3  &kp KP_DIVIDE    &none
&none  &none  &none  &none  &none         &none  &none  &none      &none  &none  &none         &none   &kp N0  &none   &kp KP_EQUAL     &none
            >;
        };
    };
};
